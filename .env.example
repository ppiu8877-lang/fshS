# Keep these secrets on the server. Do not put them in HTML or browser JavaScript.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# Shared secret for the payment provider webhook. Use a long random value and
# configure the provider to send it in the X-Payment-Webhook-Secret header.
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Optional server settings
PORT=3000
ORDERS_DB_PATH=./data/orders.sqlite
